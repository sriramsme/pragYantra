# Copy to .env and fill in your own key. The CLI loads it automatically from cwd.
# Shell variables and CLI flags take precedence. Never commit .env.
OPENAI_API_KEY=
# Optional: only for interpret / chat --interpret.
TYPESAFE_API_KEY=

# Optional provider defaults; CLI flags override these.
PRAGYANTRA_VISION_MODEL=gpt-5.6-luna
PRAGYANTRA_CHAT_MODEL=gpt-5.6-luna
PRAGYANTRA_DECISION_MODEL=jev-1.14.0
# Separate Decisions endpoint model; conversation/vision defaults stay unchanged.
PRAGYANTRA_INSPECTION_MODEL=gpt-6-luna
PRAGYANTRA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PRAGYANTRA_SPEECH_MODEL=gpt-4o-mini-tts
PRAGYANTRA_VOICE=coral
# Used only with chat --semantic-memory.
PRAGYANTRA_EMBEDDING_MODEL=text-embedding-3-small
